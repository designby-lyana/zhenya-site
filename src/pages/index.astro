---
// Головна сторінка. Розмітка, стилі й скрипти — дослівно з Webflow (src/webflow/),
// дані — з адмінки (src/content, src/data/site.json).
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import vibe from '../data/vibe.json';
import { img, catKey, slugify, media as M, embed as E } from '../lib/img';

const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const catName = Object.fromEntries(cats.map((c) => [c.id, c.data.name]));
const photos = (await getCollection('portfolio'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ ...p.data, cats: p.data.categories.map(catKey) }));
// Кнопка категорії з'являється, лише коли в ній є хоча б один показаний кадр.
const shownCats = cats.filter((c) => photos.some((p) => p.cats.includes(c.id)));
const recent = photos.filter((p) => p.recent).sort((a, b) => (a.recent ?? 0) - (b.recent ?? 0));
const albums = (await getCollection('albums'))
  .filter((a) => !a.data.hidden)
  .sort((a, b) => a.data.order - b.data.order)
  .map((a) => ({ ...a.data, slug: /^[a-z0-9-]+$/.test(a.id) ? a.id : slugify(a.data.title) }));

const { hero, about, prices, contact, contacts: c } = site;
const tel = 'tel:' + c.phone.replace(/[^\d+]/g, '');
const lb = (src: string, group: string) => JSON.stringify({ items: [{ url: M(src), type: 'image' }], group });
const titleParts = hero.title.split(hero.titleAccent);
---
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8"/>
<title>{site.seo.title}</title>
<meta content={site.seo.description} name="description"/>
<meta content={site.seo.shareTitle} property="og:title"/>
<meta content={site.seo.shareDescription} property="og:description"/>
<meta content={new URL(M(site.seo.shareImage), Astro.site).href} property="og:image"/>
<meta content={site.seo.shareTitle} name="twitter:title"/>
<meta content={site.seo.shareDescription} name="twitter:description"/>
<meta property="og:type" content="website"/>
<meta content="summary_large_image" name="twitter:card"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<link href="/wf/site.css" rel="stylesheet" type="text/css"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css?family=Raleway:400,700%7CRaleway+Dots:400&display=swap" rel="stylesheet"/>
<script is:inline set:html={E("02.js")}></script>
<link href="/favicon.svg" rel="icon" type="image/svg+xml"/>
</head>
<body><div class="w-embed"><!-- Аватарка Жені в кнопці «Написати» у шапці (десктоп). Стоїть ПЕРЕД шапкою і малюється чистим CSS — тому видно з першого кадру, без затримки. -->
<link rel="preload" as="image" href={M("/media/6ab4f49770d828296938d6a0_zh-ig-avatar.jpg")} fetchpriority="high">
<style is:inline set:html={E("03.css")}></style></div><div class="site-header"><a href="#top" class="logo w-inline-block"><div class="logo-name">{site.header.name}</div><div class="logo-city">{site.header.tagline}</div></a><div data-hg="1" class="header-genres">{site.header.genres}</div><nav class="nav"><a href="#portfolio" class="nav-link">Портфоліо</a><a href="#packages" class="nav-link">Ціни</a><a href="#contact" class="nav-link">Контакти</a></nav><a href="#contact" class="btn header-cta">{site.header.cta}</a><div class="burger"><div class="burger-line"></div><div class="burger-line"></div><div class="burger-line"></div></div></div>
<section id="top"><div class="hero-media">{hero.pair.map((p, i) => { const im = img(p.photo); return (<div class={`hero-cell hero-cell-${i === 0 ? 'l' : 'r'}`}><img src={M(p.photo)} srcset={im.srcset} sizes={im.srcset ? '100vw' : undefined} loading="lazy" alt={p.alt} class="hero-img"/></div>); })}<a href="#portfolio" class="hero-dot">↓</a><div data-hero-pool="1" class="hero-pool w-dyn-list"><div class="w-dyn-empty"><div>No items found.</div></div></div><div data-hero-pool="static">{hero.slides.map((s) => (<img src={M(s.photo)} data-scale={s.scale} data-fit={s.fit} loading="lazy" alt={s.alt}/>))}</div></div><div class="hero-text wrap"><h1 class="hero-title">{titleParts[0]}<span class="spot">{hero.titleAccent}</span>{titleParts.slice(1).join(hero.titleAccent)}</h1><p class="hero-pitch"><span class="hero-pitch-line">{hero.subtitle}</span></p><div class="hero-cta"><a href={c.instagram} class="btn is-primary">Напиши в Instagram</a><a href={c.whatsapp} class="btn">WhatsApp</a></div><div class="hero-facts">{hero.facts.map((f, i) => (<Fragment>{i > 0 && <div class="hero-fact-dot">·</div>}<div>{f.before}<span class="hero-fact-strong">{f.strong}</span>{f.after}{f.strong2 && <span class="hero-fact-strong">{f.strong2}</span>}{f.after2}</div></Fragment>))}</div></div></section>
<section id="portfolio" class="section"><h2 class="h-section">{site.portfolio.title}</h2><div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="w-tabs"><div class="tabs-menu w-tab-menu" role="tablist"><a data-w-tab="Tab 1" class="tab-link w-inline-block w-tab-link w--current" id="w-tabs-0-data-w-tab-0" href="#w-tabs-0-data-w-pane-0" role="tab" aria-controls="w-tabs-0-data-w-pane-0" aria-selected="true">Кадри</a><a data-w-tab="Tab 2" class="tab-link w-inline-block w-tab-link" tabindex="-1" id="w-tabs-0-data-w-tab-1" href="#w-tabs-0-data-w-pane-1" role="tab" aria-controls="w-tabs-0-data-w-pane-1" aria-selected="false">Альбоми</a><a data-w-tab="Tab 3" class="tab-link w-inline-block w-tab-link" tabindex="-1" id="w-tabs-0-data-w-tab-2" href="#w-tabs-0-data-w-pane-2" role="tab" aria-controls="w-tabs-0-data-w-pane-2" aria-selected="false">Останні</a></div><div class="w-tab-content"><div data-w-tab="Tab 1" class="w-tab-pane w--tab-active" id="w-tabs-0-data-w-pane-0" role="tabpanel" aria-labelledby="w-tabs-0-data-w-tab-0"><div class="filter-bar"><div class="chips"><a data-cat="all" href="#" class="chip is-active">Усі</a><div class="chips-flow w-dyn-list"><div role="list" class="chips-flow w-dyn-items">{shownCats.map((cat) => (<div role="listitem" class="w-dyn-item"><a href="#" class="chip w-inline-block"><div>{cat.data.name}</div></a></div>))}</div></div></div><div class="view-switch"><a data-mode="scroll" href="#" class="view-btn is-active">Горизонтальний скрол</a><a data-mode="grid" href="#" class="view-btn">Сітка</a></div></div><div class="w-dyn-list"><div role="list" class="gallery w-dyn-items">{photos.map((p) => { const im = img(p.photo); return (<div role="listitem" class="w-dyn-item"><a href="#" class="gallery-link w-inline-block w-lightbox" aria-label="Відкрити фото" aria-haspopup="dialog"><div class="gallery-photo"><img src={im.src} srcset={im.srcset} sizes={im.srcset ? '(max-width: 767px) 86vw, 30vw' : undefined} loading="lazy" alt={p.alt} class="gallery-img"/><div></div></div><div class="gallery-caption">{p.title}</div><script is:inline type="application/json" class="w-json" set:html={lb(p.photo, 'portfolio')}></script></a><div class="cat-tags"><div class="w-dyn-list"><div role="list" class="w-dyn-items">{p.cats.filter((k) => catName[k]).map((k) => (<div role="listitem" class="w-dyn-item"><div class="cat-tag">{catName[k]}</div></div>))}</div></div></div></div>); })}</div></div></div><div data-w-tab="Tab 2" class="w-tab-pane" id="w-tabs-0-data-w-pane-1" role="tabpanel" aria-labelledby="w-tabs-0-data-w-tab-1"><div class="w-dyn-list"><div role="list" class="albums w-dyn-items">{albums.map((a) => { const im = img(a.cover); return (<div role="listitem" class="w-dyn-item"><div data-album={a.slug} class="album-card"><div class="album-cover"><img src={im.src} srcset={im.srcset} sizes={im.srcset ? '(max-width: 767px) 100vw, 33vw' : undefined} loading="lazy" alt={a.coverAlt} class="gallery-img"/></div><div class="album-name">{a.title}</div><div class="album-count">{a.photos.length}</div><a aria-label="Відкрити альбом" href={`/albums/${a.slug}`} class="album-hit"></a></div></div>); })}</div></div></div><div data-w-tab="Tab 3" class="w-tab-pane" id="w-tabs-0-data-w-pane-2" role="tabpanel" aria-labelledby="w-tabs-0-data-w-tab-2"><div class="recent-note">{site.portfolio.recentNote}</div><div class="w-dyn-list"><div role="list" class="gallery w-dyn-items">{recent.map((p) => { const im = img(p.photo); return (<div role="listitem" class="w-dyn-item"><a href="#" class="gallery-link w-inline-block w-lightbox" aria-label="Відкрити фото" aria-haspopup="dialog"><div class="gallery-photo"><img src={im.src} srcset={im.srcset} sizes={im.srcset ? '(max-width: 767px) 50vw, 25vw' : undefined} loading="lazy" alt={p.alt} class="gallery-img"/><div class="gallery-overlay"></div></div><div class="gallery-caption">{p.title}</div><script is:inline type="application/json" class="w-json" set:html={lb(p.photo, 'recent')}></script></a></div>); })}</div></div></div></div></div></section>
<div class="about"><div class="about-photo"><img src={M(about.photo)} srcset={img(about.photo).srcset} sizes={img(about.photo).srcset ? '(max-width: 767px) 100vw, 45vw' : undefined} loading="lazy" alt={about.photoAlt} class="gallery-img"/></div><div><div class="eyebrow about-eyebrow">{about.title}</div>{about.paragraphs.map((t) => (<p class="about-p">{t}</p>))}<div class="about-facts">{hero.facts.map((f, i) => (<Fragment>{i > 0 && <div class="hero-fact-dot">·</div>}<div>{f.before}<span class="hero-fact-strong">{f.strong}</span>{f.after}{f.strong2 && <span class="hero-fact-strong">{f.strong2}</span>}{f.after2}</div></Fragment>))}</div></div></div>
<section id="about" class="section"></section><section id="packages" data-pr="1" class="section packages"><div class="w-embed w-script"><!-- Ціни v3 + хедер: стани анімації. Вмикаються лише коли працює JS.
ТЕЛЕФОН (десктоп не змінюється): герой, рядок фактів, портфоліо (стрічка на всю ширину екрана, кадр ~86% ширини по центру, по краях видно сусідні;
гортається по одному кадру — сама і свайпом; чіпи під нею; в кінці дві однакові текстові картки «Альбоми · N зйомок →» і «Усі роботи · N фото →»;
режим табів — усі три вкладки сіткою; обкладинки альбомів — випадковий заокруглений кут або без нього), «Про мене» (після цін, коротко + «Читати далі»), ціни.
Висота кадрів стрічки і фото погодинної зйомки на телефоні — однакова: --pf-hm. -->
<script is:inline set:html={E("04.js")}></script>
<style is:inline set:html={E("05.css")}></style>
</div><div class="pr-wrap"><h2 class="sr-only">{prices.title}</h2><div data-rv="1" class="pr-info">{prices.terms.map((t) => (<div class="pr-info-row"><div class="pr-info-label">{t.label}</div><div class="pr-info-text">{t.text}</div></div>))}</div>{prices.packages.slice(0, 1).map((p) => (<div class="pr-hero"><div data-rv="1" data-rv-photo="1" class="pr-photo pr-photo-hero"><div class={`pr-photo-img pr-tone-${p.tone}`}></div><div class="pr-curtain"></div><div class="pr-photo-tag">{p.photoTag}</div></div><div data-rv="1" class="pr-hero-body"><div class="pr-head"><div class="pr-eyebrow">{p.where}</div><h3 class="pr-name-hero">{p.name}</h3></div><div class="pr-price-block"><div class="pr-price"><div data-pr-price="1" class="pr-num-hero">{p.price}</div><div class="pr-cur">грн</div></div><div class="pr-caption-row"><div data-pr-caption="1" class="pr-caption">{p.per}</div></div></div>{p.hours && p.hours.length > 0 && (<div class="pr-hours"><div role="group" aria-label="Тривалість зйомки" class="pr-seg"><div data-pr-ind="1" class="pr-seg-ind"></div>{p.hours.map((h) => (<a type="button" aria-label={`${h.hours} год`} data-h={h.hours} data-price={h.price} data-per={h.per} href="#" class="pr-seg-btn w-button">{h.hours}</a>))}</div></div>)}<div class="pr-stats">{p.stats.map((s) => (<div class="pr-stat"><div class="pr-stat-num">{s.value}</div>{s.tip ? <div tabindex="0" data-tip={s.tip} class="pr-stat-label">{s.label}</div> : <div class="pr-stat-label">{s.label}</div>}</div>))}</div></div></div>))}<div class="pr-cards">{prices.packages.slice(1).map((p) => (<div data-rv="1" class="pr-card"><div class="pr-photo pr-photo-card"><div class={`pr-photo-img pr-tone-${p.tone}`}></div><div class="pr-curtain-card"></div><div class="pr-photo-tag">{p.photoTag}</div></div><div class="pr-card-body"><div class="pr-head pr-card-head">{p.note ? (<Fragment><div class="pr-card-top"><div class="pr-eyebrow">{p.where}</div></div><h3 class="pr-name">{p.name}{p.badge && <span class="pr-name-sub">{p.badge}</span>}</h3><p class="pr-note">{p.note}</p></Fragment>) : (<Fragment><div class="pr-eyebrow">{p.where}</div><h3 class="pr-name">{p.name}{p.badge && <span class="pr-name-sub">{p.badge}</span>}</h3></Fragment>)}</div><div class="pr-price-block"><div class="pr-price"><div class="pr-num">{p.price}</div><div class="pr-cur">грн</div></div><div class="pr-caption-row"><div class="pr-caption">{p.per}</div></div></div><div class="pr-stats">{p.stats.map((s) => (<div class="pr-stat"><div class="pr-stat-num">{s.value}</div>{s.tip ? <div tabindex="0" data-tip={s.tip} class="pr-stat-label">{s.label}</div> : <div class="pr-stat-label">{s.label}</div>}</div>))}</div></div></div>))}</div></div>
<div class="w-embed w-script"><!-- Хедер: рядок жанрів («види зйомок») — лише нижче героя і лише коли гортають вгору.
Вниз — ховається після ~8px руху; вгору — проявляється після ~24px (щоб не блимав від випадкових рухів).
ПОЗИЦІОНУВАННЯ під іменем («Фотографка · Львів · Кривий Ріг»): видно на першому екрані і в ті самі моменти, що й рядок жанрів (клас hg-up на шапці). -->
<style is:inline set:html={E("06.css")}></style>
<script is:inline set:html={E("07.js")}></script>
<!-- Ціни v3: перемикач годин (ціна змінюється одразу, без «набігання»), поява при скролі.
Ширина числа зафіксована по найширшому варіанту: цифри пропорційні (щоб нуль був без риски), тож без цього «грн» їздило б при перемиканні. -->
<script is:inline set:html={E("08.js")}></script>
<!-- Телефон, герой: комірки майже квадратні, фото вертикальні — для окремих кадрів своя точка кадрування (спільна — 50% 12%, у блоці «ТЕЛЕФОН»).
Щоб підправити інший кадр: частина назви файлу + object-position (друге число: 0% — верх фото, 100% — низ).
Десктоп: пара крупним планом (1K8A0024) зсунута вниз, щоб було видно обличчя дівчини. -->
<style is:inline set:html={E("09.css")}></style>
<!-- Телефон: меню за гамбургером. Світлий екран на весь телефон: «Фотографка · Львів і Кривий Ріг», великі пункти в порядку блоків на телефоні
(Портфоліо · Ціни · Про мене · Контакти), внизу — «Напиши в Instagram», «WhatsApp», телефон. Хрестик — на місці гамбургера.
Закривається хрестиком, Esc і після вибору пункту (тоді плавно веде до блоку). Поки меню відкрите — сторінка під ним не гортається. -->
<style is:inline set:html={E("10.css")}></style>
<script is:inline set:html={E("11.js")}></script>
<!-- Портфоліо, усі екрани.
ТАБИ (Категорії / Альбоми / Останні): після кліку по табу скрипт перевіряє, чи показалася потрібна вкладка; якщо анімація Webflow зависла —
сам ставить активний таб і вкладку. Вкладка мʼяко проявляється, обкладинки альбомів — піднімаючись.
«Відкрити сіткою»: на десктопі сторінка плавно доїжджає до сітки (через мʼяку прокрутку), кадри спливають хвилею.
ДЕСКТОП: менший відступ між заголовком «Портфоліо» і плівкою; блок «Яких світлин хочеться?» — відступи в тій самій пропорції, що й на телефоні (секція ~104px). -->
<style is:inline set:html={E("12.css")}></style>
<script is:inline set:html={E("13.js")}></script>
<!-- Телефон, ціни: ПОПАП «Написати Жені».
Тап по картці пакета (крім перемикача годин і підказки «із ретушшю») → віконце: назва пакета, «Напишіть Жені» і готове перше повідомлення (його можна змінити).
«Написати в Instagram» — копіює текст і відкриває чат з Женею (ig.me/m/…); Instagram не приймає готовий текст у посиланні, тому його просто вставляють.
«WhatsApp» — чат одразу з цим текстом. Закрити: хрестик, тап по затемненню, Esc. На десктопі картки не відкривають попап. -->
<style is:inline set:html={E("14.css")}></style>
<script is:inline set:html={E("15.js")}></script>
</div><div class="w-embed w-script"><!-- Телефон, попап цін як чат в Instagram.
Надпис у два рядки: зверху пакет («Погодинна зйомка · 3 години»), під ним вартість.
Замість «Напишіть Жені» + довгого пояснення — шапка чату: аватарка Жені в кольоровому кружечку Instagram (як у футері), нік і імʼя.
Готове повідомлення — як бульбашка відправленого повідомлення в інсті (справа, синьо-фіолетова). Її можна редагувати, висота підлаштовується під текст. -->
<style is:inline set:html={E("16.css")}></style>
<script is:inline set:html={E("17.js")}></script></div><div class="w-embed w-script"><!-- Телефон, ФУТЕР: відступи за ієрархією. Згори 56 → відгуки → 40 → контакти (групи через 28) → 40 → тонка лінія + © → знизу 40 (+ безпечна зона iPhone).
ДЕСКТОП, вкладка «Альбоми»: у кожної обкладинки заокруглений один випадковий кут (як на телефоні), сусідні картки не повторюються.
ДЕСКТОП, таби портфоліо: «прилипають» під шапкою лише для плівки «Категорії». У «Альбомах» і «Останніх» — звичайний рядок над картками, не налазить на обкладинки.
ТЕЛЕФОН, стрічка портфоліо: фото вантажаться наперед (на два екрани вперед від поточного кадру), щоб справа завжди було видно край наступного кадру
(Safari сам не підтягує lazy-фото в горизонтальній стрічці). Поки фото не прийшло — на його місці бежева підкладка, а не біла дірка. -->
<style is:inline set:html={E("18.css")}></style>
<script is:inline set:html={E("19.js")}></script></div><div class="w-embed w-script"><!-- ПОВЕРНЕННЯ «НАЗАД» (усі екрани). Коли людина йде з головної (наприклад, зі сітки чи вкладки «Альбоми») в альбом,
ми запамʼятовуємо: вкладку, сітка чи плівка, вибраний фільтр і місце на сторінці. Після «Назад» у браузері все відновлюється рівно так само.
Зберігається лише в цій вкладці браузера і лише на 30 хв. -->
<script is:inline set:html={E("20.js")}></script></div><div class="w-embed w-script"><!-- Хедер, рядок жанрів «Портретна, творча, сімейна. Події» — клікабельний. Кожне слово веде в портфоліо з потрібним фільтром:
Портретна → «Портрети», Творча → «Творчі», Сімейна → «З дітьми», Події → вкладка «Альбоми» (там цілі зйомки). Щоб змінити — словник MAP нижче.
Прокрутка зупиняється так, щоб заголовок «Портфоліо» був видно під шапкою (якщо інший скрипт збив — в кінці м’яко доводимо). -->
