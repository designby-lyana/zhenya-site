---
import site from '../data/site.json';
import { img } from '../lib/img';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const { title = site.seo.title, description = site.seo.description } = Astro.props;
const share = img(site.seo.shareImage).src;
const shareAbs = share.startsWith('http') ? share : new URL(share, Astro.site ?? Astro.url).href;
const c = site.contacts;
const h = site.header;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const base = isHome ? '' : '/';
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={site.seo.shareTitle} />
  <meta property="og:description" content={site.seo.shareDescription} />
  <meta property="og:image" content={shareAbs} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap" />
</head>
<body>
  <a class="skip" href="#main">До змісту</a>

  <header class="site-header">
    <a href={`${base}#top`} class="logo" aria-label={`${h.name} — на головну`}>
      <span class="logo-name">{h.name}</span>
      <span class="logo-city">{h.tagline}</span>
    </a>
    <p class="header-genres">{h.genres}</p>
    <nav class="nav" id="nav" aria-label="Головне меню">
      <a href={`${base}#portfolio`}>Портфоліо</a>
      <a href={`${base}#prices`}>Ціни</a>
      <a href={`${base}#contact`}>Контакти</a>
    </nav>
    <a href={`${base}#contact`} class="btn btn--sm header-cta">{h.cta}</a>
    <button class="burger" id="burger" aria-label="Меню" aria-expanded="false" aria-controls="nav"><span></span></button>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer" id="footer">
    <slot name="footer-top" />
    <div class="footer-cols">
      <div>
        <h2 class="footer-h">Контакти</h2>
        <ul>
          <li><a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></li>
          <li>{c.cities}</li>
          <li>{c.travel}</li>
        </ul>
      </div>
      <div>
        <h2 class="footer-h">Підписатись</h2>
        <ul>
          <li><a href={c.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{site.footer.copyright}</span>
      <span>{site.hero.title}</span>
    </div>
  </footer>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Перегляд світлини" hidden>
    <button class="lb-btn lb-close" data-lb="close" aria-label="Закрити">×</button>
    <button class="lb-btn lb-prev" data-lb="prev" aria-label="Попереднє фото">‹</button>
    <figure class="lb-figure"><img alt="" /><figcaption></figcaption></figure>
    <button class="lb-btn lb-next" data-lb="next" aria-label="Наступне фото">›</button>
  </div>

  <script src="/site.js" is:inline defer></script>
</body>
</html>
